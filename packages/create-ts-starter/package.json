{
  "name": "@lesenelir/create-ts-starter",
  "version": "0.0.7",
  "description": "Create a TypeScript library from lesenelir's ts-starter",
  "keywords": [
    "create",
    "starter",
    "template",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lesenelir/lesenelir.me.git",
    "directory": "packages/create-ts-starter"
  },
  "license": "MIT",
  "author": "lesenelir <hi@lesenelir.me>",
  "type": "module",
  "bin": "./dist/bin/index.js",
  "files": [
    "template",
    "dist"
  ],
  "scripts": {
    "@lesenelir/create-ts-starter": "node dist/bin/index.js",
    "build": "bunchee src/index.ts",
    "dev": "bunchee src/index.ts -w",
    "prepublishOnly": "pnpm template && pnpm build",
    "release:patch": "npm version patch && npm publish",
    "smoke": "sh scripts/smoke.sh",
    "template": "rm -rf template && cp -R ../../apps/ts-starter template && rm -rf template/dist template/node_modules template/coverage && mv template/.gitignore template/_gitignore && cp files/_biome.json template/biome.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@typescript/typescript6": "^6.0.2",
    "bunchee": "^7.0.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
