{
  "name": "@lesenelir/ts-starter",
  "version": "0.0.0",
  "description": "lesenelir's ts starter",
  "keywords": [
    "ts-starter"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lesenelir/[project-name].git"
  },
  "license": "MIT",
  "author": "lesenelir <hi@lesenelir.me>",
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "biome check",
    "prepack": "tsdown",
    "release": "bumpp",
    "test": "vitest",
    "test:ci": "vitest run",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^26.6.4",
    "bumpp": "^12.3.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
