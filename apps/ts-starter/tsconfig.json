{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["node"] /* TS 7 no longer auto-includes node_modules/@types. */,
    "resolveJsonModule": true,
    "noEmit": true,
    "declaration": true /* Needed by isolatedDeclarations; noEmit still writes nothing. */,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "verbatimModuleSyntax": true /* Type-only imports must use `import type`, so files transpile on their own. */,
    "isolatedDeclarations": true /* Exports carry explicit types, so tsdown emits .d.ts without the type checker. */,
    "erasableSyntaxOnly": true /* No enums or namespaces, so Node can run the source with type stripping. */,
    "skipLibCheck": true
  },
  "include": ["src", "test"]
}
