{
  "name": "lesenelir.me",
  "version": "0.0.0",
  "private": true,
  "description": "lesenelir's profile website and basic configuration for my personal projects",
  "keywords": [
    "lesenelir",
    "website",
    "ui"
  ],
  "license": "MIT",
  "author": "lesenelir <hi@lesenelir.me>",
  "type": "module",
  "scripts": {
    "build:website": "pnpm --filter @lesenelir/website build",
    "dev:website": "pnpm --filter @lesenelir/website dev",
    "check": "biome check --write .",
    "lint": "biome check .",
    "format": "biome format --write .",
    "clear": "pnpm -r exec rm -rf node_modules dist .turbo .next && rm -rf node_modules dist .turbo .next",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  }
}
